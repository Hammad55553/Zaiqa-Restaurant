{
  "name": "zaiqah-desktop",
  "version": "1.1.1",
  "description": "Zaiqa Mahal POS Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "node build-prep.js && electron-builder --dir",
    "dist": "node build-prep.js && electron-builder"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "adm-zip": "^0.5.12",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^13.0.0",
    "sqlite": "^5.1.1",
    "sqlite3": "npm:@vscode/sqlite3@^5.1.12-vscode",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "electron": "28.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.zaiqah.pos",
    "productName": "Zaiqah POS",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "package.json",
      "server/**/*",
      "server/.env",
      "web-dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
